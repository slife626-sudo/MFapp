rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMonthKey(key) {
      return key is string && key.size() == 7 && key.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidExpense(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.categoryId is string &&
             data.categoryId.size() >= 1 &&
             data.categoryId.size() <= 64 &&
             data.paymentMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCategory(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 40 &&
             data.iconKey is string &&
             data.iconKey.size() >= 1 &&
             data.iconKey.size() <= 32 &&
             data.colorHex is int &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidBudget(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             (data.monthKey == 'default' || isValidMonthKey(data.monthKey)) &&
             data.totalLimit is number &&
             data.totalLimit >= 0 &&
             data.totalLimit <= 1000000000 &&
             data.categoryLimits is map &&
             data.categoryLimits.size() <= 30 &&
             data.currencyCode is string &&
             data.currencyCode.size() >= 1 &&
             data.currencyCode.size() <= 8 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidIncome(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.paymentMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTransfer(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.fromMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.toMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.fromMethod != data.toMethod &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPayable(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.personName is string &&
             data.personName.size() >= 1 &&
             data.personName.size() <= 120 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.paidAmount is number &&
             data.paidAmount >= 0 &&
             data.paidAmount <= 1000000000 &&
             data.paymentMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.settled is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPayablePayment(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.payableId is string &&
             data.payableId.size() >= 1 &&
             data.payableId.size() <= 128 &&
             data.personName is string &&
             data.personName.size() >= 1 &&
             data.personName.size() <= 120 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.paymentMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidReceivable(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.personName is string &&
             data.personName.size() >= 1 &&
             data.personName.size() <= 120 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.collectedAmount is number &&
             data.collectedAmount >= 0 &&
             data.collectedAmount <= 1000000000 &&
             data.paymentMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.settled is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidReceivablePayment(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.receivableId is string &&
             data.receivableId.size() >= 1 &&
             data.receivableId.size() <= 128 &&
             data.personName is string &&
             data.personName.size() >= 1 &&
             data.personName.size() <= 120 &&
             data.amount is number &&
             data.amount > 0 &&
             data.amount <= 1000000000 &&
             data.paymentMethod in ['CASH', 'CARD', 'MOBILE', 'BANK'] &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             isValidMonthKey(data.monthKey) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isVerifiedEmail() {
      return isSignedIn() &&
             request.auth.token.email is string &&
             request.auth.token.email.size() >= 3 &&
             request.auth.token.email_verified == true;
    }

    function isMarketMember(data) {
      return isSignedIn() && (
        data.ownerUid == request.auth.uid ||
        (isVerifiedEmail() && request.auth.token.email.lower() in data.memberEmails)
      );
    }

    function isValidMarketList(data) {
      return data.ownerUid is string &&
             data.ownerUid.size() >= 1 &&
             data.ownerUid.size() <= 128 &&
             data.ownerEmail is string &&
             data.ownerEmail.size() >= 3 &&
             data.ownerEmail.size() <= 160 &&
             data.ownerName is string &&
             data.ownerName.size() <= 80 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.sharedWithEmail is string &&
             data.sharedWithEmail.size() <= 160 &&
             data.memberEmails is list &&
             data.memberEmails.size() >= 1 &&
             data.memberEmails.size() <= 10 &&
             data.memberEmails[0] is string &&
             data.ownerEmail in data.memberEmails &&
             data.note is string &&
             data.note.size() <= 300 &&
             data.completed is bool &&
             data.dateMillis is int &&
             data.dateMillis > 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidMarketItem(data, listId) {
      return data.listId is string &&
             data.listId == listId &&
             data.ownerUid is string &&
             data.ownerUid.size() >= 1 &&
             data.ownerUid.size() <= 128 &&
             data.memberEmails is list &&
             data.memberEmails.size() >= 1 &&
             data.memberEmails.size() <= 10 &&
             data.memberEmails[0] is string &&
             data.addedByEmail is string &&
             data.addedByEmail.size() <= 160 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             data.quantity is string &&
             data.quantity.size() <= 40 &&
             data.estimatedPrice is number &&
             data.estimatedPrice >= 0 &&
             data.estimatedPrice <= 1000000000 &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64)) &&
             data.bought is bool &&
             data.note is string &&
             data.note.size() <= 200 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/expenses/{expenseId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(expenseId);

      allow create: if isOwner(userId) &&
                       isValidId(expenseId) &&
                       incoming().keys().hasAll(['userId', 'title', 'amount', 'categoryId', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'amount', 'categoryId', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       isValidExpense(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(expenseId) &&
                       isValidExpense(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'categoryId', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(expenseId);
    }

    match /users/{userId}/incomes/{incomeId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(incomeId);

      allow create: if isOwner(userId) &&
                       isValidId(incomeId) &&
                       incoming().keys().hasAll(['userId', 'title', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       isValidIncome(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(incomeId) &&
                       isValidIncome(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(incomeId);
    }

    match /users/{userId}/transfers/{transferId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(transferId);

      allow create: if isOwner(userId) &&
                       isValidId(transferId) &&
                       incoming().keys().hasAll(['userId', 'fromMethod', 'toMethod', 'amount', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'fromMethod', 'toMethod', 'amount', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       isValidTransfer(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(transferId) &&
                       isValidTransfer(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['fromMethod', 'toMethod', 'amount', 'note', 'dateMillis', 'monthKey', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(transferId);
    }

    match /users/{userId}/payables/{payableId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(payableId);

      allow create: if isOwner(userId) &&
                       isValidId(payableId) &&
                       incoming().keys().hasAll(['userId', 'personName', 'amount', 'paidAmount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'settled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'personName', 'amount', 'paidAmount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'settled', 'createdAt', 'updatedAt']) &&
                       isValidPayable(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(payableId) &&
                       isValidPayable(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['personName', 'amount', 'paidAmount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'settled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(payableId);
    }

    match /users/{userId}/payablePayments/{paymentId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(paymentId);

      allow create: if isOwner(userId) &&
                       isValidId(paymentId) &&
                       incoming().keys().hasAll(['userId', 'payableId', 'personName', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'payableId', 'personName', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       isValidPayablePayment(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(paymentId) &&
                       isValidPayablePayment(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().payableId == existing().payableId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['personName', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(paymentId);
    }

    match /users/{userId}/receivables/{receivableId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(receivableId);

      allow create: if isOwner(userId) &&
                       isValidId(receivableId) &&
                       incoming().keys().hasAll(['userId', 'personName', 'amount', 'collectedAmount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'settled', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'personName', 'amount', 'collectedAmount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'settled', 'createdAt', 'updatedAt']) &&
                       isValidReceivable(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(receivableId) &&
                       isValidReceivable(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['personName', 'amount', 'collectedAmount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'settled', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(receivableId);
    }

    match /users/{userId}/receivablePayments/{paymentId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(paymentId);

      allow create: if isOwner(userId) &&
                       isValidId(paymentId) &&
                       incoming().keys().hasAll(['userId', 'receivableId', 'personName', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'receivableId', 'personName', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'createdAt', 'updatedAt']) &&
                       isValidReceivablePayment(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(paymentId) &&
                       isValidReceivablePayment(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().receivableId == existing().receivableId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['personName', 'amount', 'paymentMethod', 'note', 'dateMillis', 'monthKey', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(paymentId);
    }

    match /users/{userId}/categories/{categoryId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(categoryId);

      allow create: if isOwner(userId) &&
                       isValidId(categoryId) &&
                       incoming().keys().hasAll(['userId', 'name', 'iconKey', 'colorHex', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'name', 'iconKey', 'colorHex', 'createdAt', 'updatedAt']) &&
                       isValidCategory(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(categoryId) &&
                       isValidCategory(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'iconKey', 'colorHex', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(categoryId);
    }

    match /users/{userId}/budgets/{budgetId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(budgetId);

      allow create: if isOwner(userId) &&
                       isValidId(budgetId) &&
                       incoming().keys().hasAll(['userId', 'monthKey', 'totalLimit', 'categoryLimits', 'currencyCode', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'monthKey', 'totalLimit', 'categoryLimits', 'currencyCode', 'createdAt', 'updatedAt']) &&
                       isValidBudget(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(budgetId) &&
                       isValidBudget(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().monthKey == existing().monthKey &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['totalLimit', 'categoryLimits', 'currencyCode', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(budgetId);
    }

    match /marketLists/{listId} {
      allow list: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        (isVerifiedEmail() && request.auth.token.email.lower() in existing().memberEmails)
      );
      allow get: if isValidId(listId) && isMarketMember(existing());

      allow create: if isVerifiedEmail() &&
                       isValidId(listId) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().ownerEmail == request.auth.token.email.lower() &&
                       incoming().keys().hasAll(['ownerUid', 'ownerEmail', 'ownerName', 'title', 'sharedWithEmail', 'memberEmails', 'note', 'completed', 'dateMillis', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'title', 'sharedWithEmail', 'memberEmails', 'note', 'completed', 'dateMillis', 'createdAt', 'updatedAt']) &&
                       isValidMarketList(incoming());

      allow update: if isValidId(listId) &&
                       isMarketMember(existing()) &&
                       isValidMarketList(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().ownerEmail == existing().ownerEmail &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (existing().ownerUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['ownerName', 'title', 'sharedWithEmail', 'memberEmails', 'note', 'completed', 'dateMillis', 'updatedAt'])) ||
                         (incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'note', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(listId) && existing().ownerUid == request.auth.uid;

      match /items/{itemId} {
        allow list: if isSignedIn() && (
          existing().ownerUid == request.auth.uid ||
          (isVerifiedEmail() && request.auth.token.email.lower() in existing().memberEmails)
        );
        allow get: if isValidId(listId) && isValidId(itemId) && isMarketMember(existing());

        allow create: if isSignedIn() &&
                         isValidId(listId) &&
                         isValidId(itemId) &&
                         incoming().keys().hasAll(['listId', 'ownerUid', 'memberEmails', 'addedByEmail', 'name', 'quantity', 'estimatedPrice', 'bought', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['listId', 'ownerUid', 'memberEmails', 'addedByEmail', 'name', 'quantity', 'estimatedPrice', 'categoryId', 'bought', 'note', 'createdAt', 'updatedAt']) &&
                         isValidMarketItem(incoming(), listId) &&
                         getAfter(/databases/$(database)/documents/marketLists/$(listId)) != null &&
                         isMarketMember(getAfter(/databases/$(database)/documents/marketLists/$(listId)).data) &&
                         incoming().ownerUid == getAfter(/databases/$(database)/documents/marketLists/$(listId)).data.ownerUid &&
                         incoming().memberEmails == getAfter(/databases/$(database)/documents/marketLists/$(listId)).data.memberEmails;

        allow update: if isValidId(listId) &&
                         isValidId(itemId) &&
                         isMarketMember(existing()) &&
                         isValidMarketItem(incoming(), listId) &&
                         incoming().listId == existing().listId &&
                         incoming().ownerUid == existing().ownerUid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           (existing().ownerUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['memberEmails', 'name', 'quantity', 'estimatedPrice', 'categoryId', 'bought', 'note', 'updatedAt'])) ||
                           (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'quantity', 'estimatedPrice', 'categoryId', 'bought', 'note', 'updatedAt']))
                         );

        allow delete: if isValidId(listId) && isValidId(itemId) && isMarketMember(existing());
      }
    }
  }
}
