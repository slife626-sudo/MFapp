{
  "entities": {
    "Expense": {
      "title": "Expense",
      "description": "A daily expense record owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Short expense title (1-120 chars)."
        },
        "amount": {
          "type": "number",
          "description": "Positive expense amount."
        },
        "categoryId": {
          "type": "string",
          "description": "Identifier of the expense category."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["CASH", "CARD", "MOBILE", "BANK"],
          "description": "Payment channel used."
        },
        "accountId": {
          "type": "string",
          "description": "Optional CustomAccount document ID."
        },
        "note": {
          "type": "string",
          "description": "Optional expense note (0-300 chars)."
        },
        "dateMillis": {
          "type": "integer",
          "description": "Expense date/time in epoch milliseconds."
        },
        "monthKey": {
          "type": "string",
          "description": "Year-month bucket formatted as YYYY-MM."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on update."
        }
      },
      "required": [
        "userId",
        "title",
        "amount",
        "categoryId",
        "paymentMethod",
        "note",
        "dateMillis",
        "monthKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomCategory": {
      "title": "CustomCategory",
      "description": "A user-defined expense or income category.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "name": {
          "type": "string",
          "description": "Category display name (1-40 chars)."
        },
        "iconKey": {
          "type": "string",
          "description": "Icon identifier key."
        },
        "colorHex": {
          "type": "integer",
          "description": "ARGB color integer."
        },
        "categoryType": {
          "type": "string",
          "enum": ["EXPENSE", "INCOME"],
          "description": "Optional category flow type (defaults to EXPENSE)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "name",
        "iconKey",
        "colorHex",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly overall and per-category budget limits.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "monthKey": {
          "type": "string",
          "description": "Budget period key (YYYY-MM or default)."
        },
        "totalLimit": {
          "type": "number",
          "description": "Monthly overall budget limit."
        },
        "categoryLimits": {
          "type": "object",
          "description": "Map of categoryId to numeric spending limit."
        },
        "currencyCode": {
          "type": "string",
          "description": "ISO currency code such as BDT, USD, INR, EUR, GBP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "monthKey",
        "totalLimit",
        "categoryLimits",
        "currencyCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "Income": {
      "title": "Income",
      "description": "A user balance addition or income record owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Short source/title of the balance addition (1-120 chars)."
        },
        "amount": {
          "type": "number",
          "description": "Positive balance amount added."
        },
        "categoryId": {
          "type": "string",
          "description": "Optional income category identifier."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["CASH", "CARD", "MOBILE", "BANK"],
          "description": "Channel where balance was added."
        },
        "accountId": {
          "type": "string",
          "description": "Optional CustomAccount document ID."
        },
        "note": {
          "type": "string",
          "description": "Optional note (0-300 chars)."
        },
        "dateMillis": {
          "type": "integer",
          "description": "Date/time in epoch milliseconds."
        },
        "monthKey": {
          "type": "string",
          "description": "Year-month bucket formatted as YYYY-MM."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on update."
        }
      },
      "required": [
        "userId",
        "title",
        "amount",
        "paymentMethod",
        "note",
        "dateMillis",
        "monthKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccountTransfer": {
      "title": "AccountTransfer",
      "description": "An internal transfer between two user accounts (Cash, Bank, Mobile Banking, Card, or custom accounts).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "fromMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Source account channel." },
        "toMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Destination account channel." },
        "fromAccountId": { "type": "string", "description": "Optional source CustomAccount ID." },
        "toAccountId": { "type": "string", "description": "Optional destination CustomAccount ID." },
        "amount": { "type": "number", "description": "Positive transfer amount." },
        "note": { "type": "string", "description": "Optional transfer note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Transfer timestamp in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fromMethod", "toMethod", "amount", "note", "dateMillis", "monthKey", "createdAt", "updatedAt"]
    },
    "Payable": {
      "title": "Payable",
      "description": "A borrowed money record creating a payable owed to a lender.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "personName": { "type": "string", "description": "Name of lender / person owed (1-120 chars)." },
        "amount": { "type": "number", "description": "Positive principal borrowed amount." },
        "paidAmount": { "type": "number", "description": "Total amount repaid so far (>= 0)." },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Account that received the borrowed money." },
        "accountId": { "type": "string", "description": "Optional CustomAccount document ID." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Borrow date/time in epoch milliseconds." },
        "dueDateMillis": { "type": "integer", "description": "Optional due date in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "settled": { "type": "boolean", "description": "Whether the payable has been fully repaid." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "personName", "amount", "paidAmount", "paymentMethod", "note", "dateMillis", "monthKey", "settled", "createdAt", "updatedAt"]
    },
    "PayablePayment": {
      "title": "PayablePayment",
      "description": "A partial or full repayment against a Payable.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "payableId": { "type": "string", "description": "ID of the parent Payable." },
        "personName": { "type": "string", "description": "Lender name snapshot." },
        "amount": { "type": "number", "description": "Positive repayment amount." },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Account from which repayment was paid." },
        "accountId": { "type": "string", "description": "Optional CustomAccount document ID." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Repayment date/time in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "payableId", "personName", "amount", "paymentMethod", "note", "dateMillis", "monthKey", "createdAt", "updatedAt"]
    },
    "Receivable": {
      "title": "Receivable",
      "description": "A lent money record creating a receivable owed by a borrower.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "personName": { "type": "string", "description": "Name of borrower / person who owes money (1-120 chars)." },
        "amount": { "type": "number", "description": "Positive principal lent amount." },
        "collectedAmount": { "type": "number", "description": "Total amount collected back so far (>= 0)." },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Account from which money was lent." },
        "accountId": { "type": "string", "description": "Optional CustomAccount document ID." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Lending date/time in epoch milliseconds." },
        "dueDateMillis": { "type": "integer", "description": "Optional due date in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "settled": { "type": "boolean", "description": "Whether the receivable has been fully collected." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "personName", "amount", "collectedAmount", "paymentMethod", "note", "dateMillis", "monthKey", "settled", "createdAt", "updatedAt"]
    },
    "ReceivablePayment": {
      "title": "ReceivablePayment",
      "description": "A partial or full collection received against a Receivable.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "receivableId": { "type": "string", "description": "ID of the parent Receivable." },
        "personName": { "type": "string", "description": "Borrower name snapshot." },
        "amount": { "type": "number", "description": "Positive collected amount." },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Account into which collection was received." },
        "accountId": { "type": "string", "description": "Optional CustomAccount document ID." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Collection date/time in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "receivableId", "personName", "amount", "paymentMethod", "note", "dateMillis", "monthKey", "createdAt", "updatedAt"]
    },
    "CustomAccount": {
      "title": "CustomAccount",
      "description": "A user-configured wallet or bank/card/mobile account with opening balance, icon, and color.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "name": { "type": "string", "description": "Account display name (1-60 chars)." },
        "accountType": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Underlying payment channel type." },
        "iconKey": { "type": "string", "description": "Icon key identifier (1-32 chars)." },
        "colorHex": { "type": "integer", "description": "ARGB color integer." },
        "openingBalance": { "type": "number", "description": "Initial account balance." },
        "currencyCode": { "type": "string", "description": "ISO currency code (1-8 chars)." },
        "custom": { "type": "boolean", "description": "Whether created by the user." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "accountType", "iconKey", "colorHex", "openingBalance", "currencyCode", "custom", "createdAt", "updatedAt"]
    },
    "TrashItem": {
      "title": "TrashItem",
      "description": "A soft-deleted record retained for 30 days in the recycle bin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "entityType": { "type": "string", "enum": ["EXPENSE", "INCOME", "TRANSFER", "PAYABLE", "RECEIVABLE"], "description": "Original record entity type." },
        "sourceId": { "type": "string", "description": "Original document ID." },
        "title": { "type": "string", "description": "Display title or person name (1-120 chars)." },
        "amount": { "type": "number", "description": "Record amount (>= 0)." },
        "deletedAtMillis": { "type": "integer", "description": "Deletion timestamp in epoch milliseconds." },
        "payload": { "type": "object", "description": "Serialized primitive fields needed to restore the item." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "entityType", "sourceId", "title", "amount", "deletedAtMillis", "payload", "createdAt", "updatedAt"]
    },
    "MarketList": {
      "title": "MarketList",
      "description": "A personal or email-shared market/grocery shopping list.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "description": "Firebase Auth UID of the creator." },
        "ownerEmail": { "type": "string", "description": "Normalized lowercased creator email." },
        "ownerName": { "type": "string", "description": "Creator display name snapshot." },
        "title": { "type": "string", "description": "Market list title (1-120 chars)." },
        "sharedWithEmail": { "type": "string", "description": "Normalized lowercased recipient email or empty." },
        "memberEmails": { "type": "array", "description": "Bounded list (1-10) of normalized emails allowed to access this list." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "completed": { "type": "boolean", "description": "Whether shopping for this list is finished." },
        "dateMillis": { "type": "integer", "description": "Target/created date in epoch milliseconds." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "ownerEmail", "ownerName", "title", "sharedWithEmail", "memberEmails", "note", "completed", "dateMillis", "createdAt", "updatedAt"]
    },
    "MarketListItem": {
      "title": "MarketListItem",
      "description": "A grocery item inside a MarketList with denormalized member authorization.",
      "type": "object",
      "properties": {
        "listId": { "type": "string", "description": "Parent MarketList document ID." },
        "ownerUid": { "type": "string", "description": "Creator UID from parent MarketList." },
        "memberEmails": { "type": "array", "description": "Denormalized bounded list (1-10) of member emails." },
        "addedByEmail": { "type": "string", "description": "Normalized email of user who added this item." },
        "name": { "type": "string", "description": "Item name (1-120 chars)." },
        "quantity": { "type": "string", "description": "Item quantity text (0-40 chars)." },
        "estimatedPrice": { "type": "number", "description": "Estimated or actual price (>= 0)." },
        "categoryId": { "type": "string", "description": "Expense category identifier (defaults to groceries)." },
        "bought": { "type": "boolean", "description": "Whether the item has been bought." },
        "note": { "type": "string", "description": "Optional note (0-200 chars)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["listId", "ownerUid", "memberEmails", "addedByEmail", "name", "quantity", "estimatedPrice", "bought", "note", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "User-scoped daily expense entries."
    },
    "/users/{userId}/incomes/{incomeId}": {
      "schema": { "$ref": "#/entities/Income" },
      "description": "User-scoped wallet balance and income additions."
    },
    "/users/{userId}/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/AccountTransfer" },
      "description": "User-scoped transfers between Cash, Bank, Mobile Banking, Card, and custom accounts."
    },
    "/users/{userId}/payables/{payableId}": {
      "schema": { "$ref": "#/entities/Payable" },
      "description": "User-scoped borrowed money and payables owed."
    },
    "/users/{userId}/payablePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/PayablePayment" },
      "description": "User-scoped repayments against payables."
    },
    "/users/{userId}/receivables/{receivableId}": {
      "schema": { "$ref": "#/entities/Receivable" },
      "description": "User-scoped lent money and receivables owed to the user."
    },
    "/users/{userId}/receivablePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/ReceivablePayment" },
      "description": "User-scoped collections received against receivables."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CustomCategory" },
      "description": "User-scoped custom expense and income categories."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/MonthlyBudget" },
      "description": "User-scoped monthly and default budget limits."
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/CustomAccount" },
      "description": "User-scoped custom wallet/bank/card/mobile accounts."
    },
    "/users/{userId}/trash/{trashId}": {
      "schema": { "$ref": "#/entities/TrashItem" },
      "description": "User-scoped 30-day soft-delete recycle bin items."
    },
    "/marketLists/{listId}": {
      "schema": { "$ref": "#/entities/MarketList" },
      "description": "Email-shared grocery/market lists accessible to creator and shared spouse/partner."
    },
    "/marketLists/{listId}/items/{itemId}": {
      "schema": { "$ref": "#/entities/MarketListItem" },
      "description": "Grocery items inside a market list with denormalized membership."
    }
  }
}
