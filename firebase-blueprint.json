{
  "entities": {
    "Expense": {
      "title": "Expense",
      "description": "A daily expense record owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Short expense title (1-120 chars)."
        },
        "amount": {
          "type": "number",
          "description": "Positive expense amount."
        },
        "categoryId": {
          "type": "string",
          "description": "Identifier of the expense category."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["CASH", "CARD", "MOBILE", "BANK"],
          "description": "Payment channel used."
        },
        "note": {
          "type": "string",
          "description": "Optional expense note (0-300 chars)."
        },
        "dateMillis": {
          "type": "integer",
          "description": "Expense date/time in epoch milliseconds."
        },
        "monthKey": {
          "type": "string",
          "description": "Year-month bucket formatted as YYYY-MM."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on update."
        }
      },
      "required": [
        "userId",
        "title",
        "amount",
        "categoryId",
        "paymentMethod",
        "note",
        "dateMillis",
        "monthKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomCategory": {
      "title": "CustomCategory",
      "description": "A user-defined expense category.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "name": {
          "type": "string",
          "description": "Category display name (1-40 chars)."
        },
        "iconKey": {
          "type": "string",
          "description": "Icon identifier key."
        },
        "colorHex": {
          "type": "integer",
          "description": "ARGB color integer."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "name",
        "iconKey",
        "colorHex",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonthlyBudget": {
      "title": "MonthlyBudget",
      "description": "Monthly overall and per-category budget limits.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "monthKey": {
          "type": "string",
          "description": "Budget period key (YYYY-MM or default)."
        },
        "totalLimit": {
          "type": "number",
          "description": "Monthly overall budget limit."
        },
        "categoryLimits": {
          "type": "object",
          "description": "Map of categoryId to numeric spending limit."
        },
        "currencyCode": {
          "type": "string",
          "description": "ISO currency code such as BDT, USD, INR, EUR, GBP."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "monthKey",
        "totalLimit",
        "categoryLimits",
        "currencyCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "Income": {
      "title": "Income",
      "description": "A user balance addition or income record owned by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner."
        },
        "title": {
          "type": "string",
          "description": "Short source/title of the balance addition (1-120 chars)."
        },
        "amount": {
          "type": "number",
          "description": "Positive balance amount added."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["CASH", "CARD", "MOBILE", "BANK"],
          "description": "Channel where balance was added."
        },
        "note": {
          "type": "string",
          "description": "Optional note (0-300 chars)."
        },
        "dateMillis": {
          "type": "integer",
          "description": "Date/time in epoch milliseconds."
        },
        "monthKey": {
          "type": "string",
          "description": "Year-month bucket formatted as YYYY-MM."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp (FieldValue.serverTimestamp()) on update."
        }
      },
      "required": [
        "userId",
        "title",
        "amount",
        "paymentMethod",
        "note",
        "dateMillis",
        "monthKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccountTransfer": {
      "title": "AccountTransfer",
      "description": "An internal transfer between two user accounts (Cash, Bank, Mobile Banking, Card).",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "fromMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Source account." },
        "toMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Destination account." },
        "amount": { "type": "number", "description": "Positive transfer amount." },
        "note": { "type": "string", "description": "Optional transfer note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Transfer timestamp in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fromMethod", "toMethod", "amount", "note", "dateMillis", "monthKey", "createdAt", "updatedAt"]
    },
    "Payable": {
      "title": "Payable",
      "description": "A borrowed money record creating a payable owed to a lender.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "personName": { "type": "string", "description": "Name of lender / person owed (1-120 chars)." },
        "amount": { "type": "number", "description": "Positive principal borrowed amount." },
        "paidAmount": { "type": "number", "description": "Total amount repaid so far (>= 0)." },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Account that received the borrowed money." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Borrow date/time in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "settled": { "type": "boolean", "description": "Whether the payable has been fully repaid." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "personName", "amount", "paidAmount", "paymentMethod", "note", "dateMillis", "monthKey", "settled", "createdAt", "updatedAt"]
    },
    "PayablePayment": {
      "title": "PayablePayment",
      "description": "A partial or full repayment against a Payable.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner." },
        "payableId": { "type": "string", "description": "ID of the parent Payable." },
        "personName": { "type": "string", "description": "Lender name snapshot." },
        "amount": { "type": "number", "description": "Positive repayment amount." },
        "paymentMethod": { "type": "string", "enum": ["CASH", "CARD", "MOBILE", "BANK"], "description": "Account from which repayment was paid." },
        "note": { "type": "string", "description": "Optional note (0-300 chars)." },
        "dateMillis": { "type": "integer", "description": "Repayment date/time in epoch milliseconds." },
        "monthKey": { "type": "string", "description": "Year-month bucket formatted as YYYY-MM." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "payableId", "personName", "amount", "paymentMethod", "note", "dateMillis", "monthKey", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "User-scoped daily expense entries."
    },
    "/users/{userId}/incomes/{incomeId}": {
      "schema": { "$ref": "#/entities/Income" },
      "description": "User-scoped wallet balance and income additions."
    },
    "/users/{userId}/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/AccountTransfer" },
      "description": "User-scoped transfers between Cash, Bank, Mobile Banking, and Card."
    },
    "/users/{userId}/payables/{payableId}": {
      "schema": { "$ref": "#/entities/Payable" },
      "description": "User-scoped borrowed money and payables owed."
    },
    "/users/{userId}/payablePayments/{paymentId}": {
      "schema": { "$ref": "#/entities/PayablePayment" },
      "description": "User-scoped repayments against payables."
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CustomCategory" },
      "description": "User-scoped custom expense categories."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/MonthlyBudget" },
      "description": "User-scoped monthly and default budget limits."
    }
  }
}
